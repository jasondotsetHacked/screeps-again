{
  "name": "screeps-again",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/world/rooms.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "world:me": "tsx tools/world/me.ts",
    "world:shards": "tsx tools/world/shards.ts",
    "world:room": "tsx tools/world/room.ts",
    "world:region": "tsx tools/world/region.ts"
  },
  "dependencies": {
    "screeps-api": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/screeps": "^3.4.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
